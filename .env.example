# Copy to .env for local runs. NEVER commit .env or bake it into an image.

DATABASE_URL=postgresql+psycopg://docmind:docmind@localhost:5432/docmind
REDIS_URL=redis://localhost:6379/0

# --- LLM: LangGraph agentic RAG on Groq (default) ---
# Free API key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
MAX_QUERY_REWRITES=1

# Offline mode instead (no key, no LLM — answers are extracted sentences):
# LLM_PROVIDER=extractive

# --- Embeddings (Groq has no embeddings API) ---
# "hash" = free/offline. "openai" = real semantic embeddings via any OpenAI-compatible API.
EMBEDDING_PROVIDER=hash
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...

# --- Optional: trace every LangGraph run in LangSmith ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=docmind

LOG_LEVEL=INFO
APP_VERSION=dev
